# Laravel API base URL, used by server components (never exposed to the browser).
API_URL=https://api.dhagrwproperties.com

# Public URL of the Property Admin app, for "Post a property" and "Log in" links.
NEXT_PUBLIC_PORTAL_URL=https://portal.dhagrwproperties.com

# Public URL of this site, for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://staging.dhagrwproperties.com

# Host that serves listing photos (Laravel APP_URL) and whether to skip image optimization.
# Next.js refuses to optimize images from local IPs, so keep this true for local development.
API_MEDIA_URL=https://api.dhagrwproperties.com
NEXT_IMAGE_UNOPTIMIZED=true

# Optional: share the login cookie across subdomains in production, e.g. .example.com
SESSION_COOKIE_DOMAIN=
